[Unit]
Description=Interactive Node Activity Host Reporter
Documentation=https://github.com/Josh-Archer/interactive-node-controller
After=network-online.target systemd-logind.service
Wants=network-online.target

[Service]
Type=simple
User=nodeactivity
Group=nodeactivity
ExecStart=/usr/local/bin/node-activity-reporter --config /etc/node-activity-reporter/config.yaml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
